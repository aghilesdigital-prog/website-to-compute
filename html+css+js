// === كود JavaScript لصفحتك التسويقية (script.js) ===
// =================================================

// 1. رسالة ترحيبية فور تحميل الصفحة
window.onload = function() {
    console.log("الصفحة جاهزة للعمل!");
    // يمكن هنا إظهار رسالة بسيطة
    // alert("مرحباً بك! موقعك يعمل بشكل ممتاز.");
};

// 2. تفعيل التفاعل على زر الدعوة للعمل (CTA Button)
const ctaButton = document.querySelector('.cta-button');

function handleCtaClick(event) {
    // منع السلوك الافتراضي للزر (إذا كان زر إرسال نموذج)
    event.preventDefault();

    // تغيير محتوى الزر وتنسيقه
    ctaButton.textContent = "🎉 شكراً لك! سيتم نقلك للأسفل! 🎉";
    ctaButton.style.backgroundColor = '#1a73e8'; // أزرق

    // بعد التفاعل، قم بنقل المستخدم بلطف إلى قسم الملخصات
    setTimeout(() => {
        document.querySelector('#services').scrollIntoView({ 
            behavior: 'smooth' 
        });
    }, 500); // 500ms = نصف ثانية انتظار
    
    // إزالة خاصية النقر لتجنب التكرار
    ctaButton.removeEventListener('click', handleCtaClick);
}

ctaButton.addEventListener('click', handleCtaClick);


// 3. إضافة ميزة التمرير السلس (Smooth Scrolling) لروابط القائمة
document.querySelectorAll('nav a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        e.preventDefault(); // منع القفز السريع

        document.querySelector(this.getAttribute('href')).scrollIntoView({
            behavior: 'smooth' // التمرير بسلاسة
        });
    });
});
}
